# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB — leave blank to use the bundled persistent in-memory MongoDB
# (data is stored in server/.data/mongo). In production set an Atlas URI.
MONGODB_URI=

# Auth — replace with a long random string in production
JWT_SECRET=replace-with-a-long-random-string

# ImageKit (optional — without keys, photos are stored on local disk)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# AI provider (OpenAI-compatible: OpenAI, OpenRouter, Groq, DeepSeek...)
# Leave blank to use a local Ollama model, then the built-in draft engine.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Local Ollama fallback
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
